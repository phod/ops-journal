{
  "name": "ops-journal",
  "version": "1.0.0",
  "description": "A menu-bar investigation journal app",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-rebuild -f -w better-sqlite3 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
